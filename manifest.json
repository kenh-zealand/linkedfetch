{
  "manifest_version": 3,
  "name": "LinkedIn til Notion – gemte opslag",
  "version": "0.9.1",
  "description": "Kopierer dine gemte LinkedIn-opslag til Notion og/eller dit eget dashboard på keha.dk, og tjekker dagligt for nye.",
  "author": "Kenneth Hansen",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://api.notion.com/*",
    "https://media.licdn.com/*",
    "https://keha.dk/*",
    "https://www.keha.dk/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "LinkedIn til Notion"
  },
  "options_page": "options.html"
}